{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "node"
        ],
        "rootDir": ".",
        "outDir": "dist"
    },
    "include": [
        "./contracts",
        "./scripts",
        "./test",
        "./hardhat.config.ts"
    ]
}