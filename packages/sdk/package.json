{
  "name": "@agentrail/sdk",
  "version": "2.0.0",
  "description": "Official TypeScript SDK for the AgentRail Infrastructure Platform",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/client.ts --format cjs,esm --dts --clean --name AgentRail",
    "dev": "tsup src/client.ts --format cjs,esm --watch --dts",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "@types/node": "^20.11.0",
    "@agentrail/db": "workspace:*",
    "uuid": "^9.0.1",
    "@types/uuid": "^9.0.7"
  },

  "publishConfig": {
    "access": "public"
  }
}
