# --- DATABASE (Supabase) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- CACHE & QUEUES (Redis) ---
REDIS_URL=redis://localhost:6379

# --- SECURITY (KMS) ---
KMS_PROVIDER=local
# Must be at least 32 characters
LOCAL_KMS_MASTER_KEY=dev_master_key_must_be_32_chars_long_for_security
LOCAL_KMS_KEY_VERSION=v1

# --- NETWORK (Kaspa) ---
# mock | testnet-10 | mainnet
KASPA_NETWORK=mock
MOCK_KASPA_FAIL_BROADCAST=false
MOCK_KASPA_CONFIRM_DELAY_MS=3000

# --- API ---
PORT=3001
API_BASE_URL=http://localhost:3001
NODE_ENV=development

# --- WEBHOOKS ---
WEBHOOK_SECRET=dev_webhook_secret_key
